#!/usr/bin/env zsh

set -u

readonly WORK_VERSION="0.1.0"

die() {
    print -u2 -- "work: $*"
    return 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_command herdr
require_command python3

get_sessions() {
    local output
    local exit_code

    output="$(herdr session list --json 2>&1)"
    exit_code=$?

    if (( exit_code != 0 )); then
        print -u2 -- "work: unable to list Herdr sessions"
        print -u2 -- "$output"
        return "$exit_code"
    fi

    print -r -- "$output" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

for session in data.get("sessions", []):
    name = session.get("name") or session.get("session_name")

    if name:
        print(name)
'
}

get_workspaces() {
    local session="$1"
    local output
    local exit_code

    output="$(HERDR_SESSION="$session" herdr workspace list 2>&1)"
    exit_code=$?

    if (( exit_code != 0 )); then
        print -u2 -- "work: unable to list workspaces for session '$session'"
        print -u2 -- "$output"
        return "$exit_code"
    fi

    print -r -- "$output" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

for workspace in data.get("result", {}).get("workspaces", []):
    workspace_id = workspace.get("workspace_id")
    label = workspace.get("label")

    if workspace_id and label:
        print(f"{workspace_id}\t{label}")
'
}

session_exists() {
    local wanted="$1"
    local session

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        if [[ "${session:l}" == "${wanted:l}" ]]; then
            return 0
        fi
    done < <(get_sessions)

    return 1
}

find_session() {
    local wanted="$1"
    local session

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        if [[ "${session:l}" == "${wanted:l}" ]]; then
            print -r -- "$session"
            return 0
        fi
    done < <(get_sessions)

    return 1
}

workspace_lookup() {
    local wanted="$1"
    local session
    local workspace_id
    local label

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue

            if [[ "${label:l}" == "${wanted:l}" ]]; then
                print -r -- "$session"$'\t'"$workspace_id"$'\t'"$label"
                return 0
            fi
        done < <(get_workspaces "$session")
    done < <(get_sessions)

    return 1
}

get_completion_contexts() {
    local session
    local workspace_id
    local label

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        print -r -- "$session"

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue

            print -r -- "$label"
        done < <(get_workspaces "$session")
    done < <(get_sessions)
}

similar_names() {
    local wanted="$1"
    local names=()
    local session
    local workspace_id
    local label

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        names+=("$session")

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue

            names+=("$label")
        done < <(get_workspaces "$session")
    done < <(get_sessions)

    (( ${#names[@]} > 0 )) || return 0

    python3 - "$wanted" "${names[@]}" <<'PY'
import difflib
import sys

wanted = sys.argv[1]
names = sys.argv[2:]

wanted_lower = wanted.lower()

scored = []

for name in names:
    score = difflib.SequenceMatcher(
        None,
        wanted_lower,
        name.lower(),
    ).ratio()

    scored.append((score, name))

scored.sort(key=lambda item: (-item[0], item[1].lower()))

for score, name in scored[:5]:
    if score >= 0.45:
        print(name)
PY
}

attach_session() {
    local session="$1"

    print "Opening session: $session"

    exec herdr session attach "$session"
}

focus_workspace() {
    local session="$1"
    local workspace_id="$2"
    local label="$3"

    print "Opening workspace: $label"

    HERDR_SESSION="$session" herdr \
        workspace focus "$workspace_id" >/dev/null || {
        die "unable to focus workspace '$label'"
        return 1
    }

    exec env HERDR_SESSION="$session" herdr
}

create_session() {
    local name="$1"
    local answer

    print
    print "Create session '$name'?"
    print "  y) Create"
    print "  n) Cancel"
    print -n "Choice [y/N]: "

    read -r answer

    case "$answer" in
        y|Y|yes|YES)
            print "Opening session: $name"
            exec herdr session attach "$name"
            ;;
        *)
            return 0
            ;;
    esac
}

select_session() {
    local label="$1"
    local sessions=()
    local session
    local selected
    local choice
    local i=1

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        sessions+=("$session")
    done < <(get_sessions)

    if (( ${#sessions[@]} == 0 )); then
        print
        print "No Herdr session exists yet."
        print
        print -n "Session name: "

        read -r selected

        [[ -n "$selected" ]] || return 1

        print
        print "Opening session: $selected"

        exec herdr session attach "$selected"
    fi

    print
    print "Select a session for workspace '$label':"
    print

    for session in "${sessions[@]}"; do
        print "  $i) $session"
        ((i++))
    done

    print
    print -n "Choice [1]: "

    read -r choice

    [[ -z "$choice" ]] && choice=1

    if ! [[ "$choice" =~ '^[0-9]+$' ]]; then
        die "invalid session selection"
        return 1
    fi

    if (( choice < 1 || choice > ${#sessions[@]} )); then
        die "invalid session selection"
        return 1
    fi

    REPLY="${sessions[$choice]}"
}

create_workspace() {
    local label="$1"
    local session="${2:-}"
    local cwd="$PWD"
    local answer

    if [[ -z "$session" ]]; then
        select_session "$label" || return 1
        session="$REPLY"
    fi

    print
    print "Create workspace:"
    print "  Session: $session"
    print "  Label:   $label"
    print "  CWD:     $cwd"
    print
    print -n "Create? [y/N]: "

    read -r answer

    case "$answer" in
        y|Y|yes|YES)
            HERDR_SESSION="$session" herdr \
                workspace create \
                --cwd "$cwd" \
                --label "$label" \
                --focus >/dev/null || {
                die "unable to create workspace '$label'"
                return 1
            }

            print "Opening workspace: $label"

            exec env HERDR_SESSION="$session" herdr
            ;;
        *)
            return 0
            ;;
    esac
}

show_menu() {
    local sessions=()
    local session
    local workspace_id
    local label
    local index=1
    local choice
    local target
    local type
    local target_session
    local target_workspace_id
    local target_label
    local answer
    local selected

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        sessions+=("$session")
    done < <(get_sessions)

    print
    print "Work"
    print "────────────────────────────────────────"

    if (( ${#sessions[@]} == 0 )); then
        print
        print "No Herdr session exists yet."
        print
        print -n "Create a session? [y/N]: "

        read -r answer

        case "$answer" in
            y|Y|yes|YES)
                print
                print -n "Session name: "

                read -r selected

                [[ -n "$selected" ]] || return 1

                exec herdr session attach "$selected"
                ;;
            *)
                return 0
                ;;
        esac
    fi

    local -a targets=()

    for session in "${sessions[@]}"; do
        print "  $index) [session] $session"

        targets+=(
            "session"$'\t'"$session"
        )

        ((index++))

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue

            print "  $index)   [workspace] $label"

            targets+=(
                "workspace"$'\t'"$session"$'\t'"$workspace_id"$'\t'"$label"
            )

            ((index++))
        done < <(get_workspaces "$session")
    done

    print
    print -n "Choice [1]: "

    read -r choice

    [[ -z "$choice" ]] && choice=1

    if ! [[ "$choice" =~ '^[0-9]+$' ]]; then
        die "invalid selection"
        return 1
    fi

    if (( choice < 1 || choice > ${#targets[@]} )); then
        die "invalid selection"
        return 1
    fi

    target="${targets[$choice]}"

    case "$target" in
        session$'\t'*)
            target_session="${target#*$'\t'}"
            attach_session "$target_session"
            ;;
        workspace$'\t'*)
            target="${target#*$'\t'}"

            IFS=$'\t' read -r \
                target_session \
                target_workspace_id \
                target_label <<< "$target"

            focus_workspace \
                "$target_session" \
                "$target_workspace_id" \
                "$target_label"
            ;;
        *)
            die "invalid target"
            return 1
            ;;
    esac
}

open_target() {
    local wanted="$1"
    local session
    local workspace_result
    local target_session
    local target_workspace_id
    local target_label
    local suggestions=()
    local suggestion
    local choice
    local answer

    session="$(find_session "$wanted" 2>/dev/null)"

    if [[ -n "$session" ]]; then
        attach_session "$session"
        return
    fi

    workspace_result="$(workspace_lookup "$wanted")"

    if [[ -n "$workspace_result" ]]; then
        IFS=$'\t' read -r \
            target_session \
            target_workspace_id \
            target_label <<< "$workspace_result"

        focus_workspace \
            "$target_session" \
            "$target_workspace_id" \
            "$target_label"

        return
    fi

    print
    print "No session or workspace named '$wanted'."

    while IFS= read -r suggestion; do
        [[ -n "$suggestion" ]] || continue

        suggestions+=("$suggestion")
    done < <(similar_names "$wanted")

    if (( ${#suggestions[@]} > 0 )); then
        print
        print "Did you mean:"
        print

        local i=1

        for suggestion in "${suggestions[@]}"; do
            print "  $i) $suggestion"
            ((i++))
        done

        print
        print "  q) Cancel"
        print
        print -n "Choice [q]: "

        read -r choice

        if [[ "$choice" =~ '^[0-9]+$' ]] &&
            (( choice >= 1 && choice <= ${#suggestions[@]} )); then

            open_target "${suggestions[$choice]}"
            return
        fi

        [[ "$choice" != "q" && "$choice" != "Q" ]] || return 0
    fi

    print
    print "Create '$wanted' as:"
    print "  1) Session"
    print "  2) Workspace"
    print "  q) Cancel"
    print
    print -n "Choice [q]: "

    read -r answer

    case "$answer" in
        1)
            create_session "$wanted"
            ;;
        2)
            create_workspace "$wanted"
            ;;
        *)
            return 0
            ;;
    esac
}

show_help() {
    cat <<'EOF'
Usage:
  work
  work <session-or-workspace>

Description:
  Open a Herdr session or workspace.

Behavior:
  work
      Interactively select a session or workspace.

  work <name>
      Open an exact session first.
      Otherwise find a workspace with that name.
      Matching is case-insensitive.
      If nothing matches, suggest similar names and offer creation.

Options:
  --help              Show this help.
  --version           Show the version.
  --completion-zsh    Print zsh completion candidates.
  --completion-bash   Print bash completion candidates.
EOF
}

main() {
    local argument="${1:-}"

    case "$argument" in
        --help|-h)
            show_help
            return 0
            ;;

        --version|-v)
            print -- "$WORK_VERSION"
            return 0
            ;;

        --completion-zsh)
            get_completion_contexts
            return 0
            ;;

        --completion-bash)
            get_completion_contexts
            return 0
            ;;

        --*)
            die "unknown option: $argument"
            return 1
            ;;
    esac

    if (( $# > 1 )); then
        die "too many arguments"
        print -u2 -- "usage: work [session-or-workspace]"
        return 1
    fi

    if (( $# == 0 )); then
        show_menu
        return $?
    fi

    open_target "$1"
}

main "$@"
