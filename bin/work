#!/usr/bin/env zsh

set -u

readonly WORK_VERSION="0.1.0"

die() {
    print -u2 -- "work: $*"
    return 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_command herdr
require_command python3

get_sessions() {
    herdr session list --json 2>/dev/null \
        | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

for session in data.get("sessions", []):
    name = session.get("name") or session.get("session_name")
    if name:
        print(name)
'
}

get_workspaces() {
    local session="$1"

    herdr --session "$session" workspace list --json 2>/dev/null \
        | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

workspaces = data.get("result", {}).get("workspaces", [])

for workspace in workspaces:
    workspace_id = workspace.get("workspace_id")
    label = workspace.get("label")

    if workspace_id and label:
        print(f"{workspace_id}\t{label}")
'
}

session_exists() {
    local wanted="$1"
    local session

    while IFS= read -r session; do
        [[ "$session" == "$wanted" ]] && return 0
    done < <(get_sessions)

    return 1
}

workspace_lookup() {
    local wanted="$1"
    local session
    local workspace_id
    local label

    while IFS= read -r session; do
        while IFS=$'\t' read -r workspace_id label; do
            [[ "$label" == "$wanted" ]] || continue

            print -r -- "$session"$'\t'"$workspace_id"$'\t'"$label"
            return 0
        done < <(get_workspaces "$session")
    done < <(get_sessions)

    return 1
}

get_completion_contexts() {
    local session
    local workspace_id
    local label

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        print -r -- "$session"

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue
            print -r -- "$label"
        done < <(get_workspaces "$session")
    done < <(get_sessions)
}

similar_names() {
    local wanted="$1"
    local names=()
    local session
    local workspace_id
    local label

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue

        names+=("$session")

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue
            names+=("$label")
        done < <(get_workspaces "$session")
    done < <(get_sessions)

    (( ${#names[@]} > 0 )) || return 0

    python3 - "$wanted" "${names[@]}" <<'PY'
import difflib
import sys

wanted = sys.argv[1]
names = sys.argv[2:]

matches = difflib.get_close_matches(
    wanted,
    names,
    n=5,
    cutoff=0.45,
)

for name in matches:
    print(name)
PY
}

attach_session() {
    local session="$1"

    print "Opening session: $session"

    exec herdr session attach "$session"
}

focus_workspace() {
    local session="$1"
    local workspace_id="$2"
    local label="$3"

    print "Opening workspace: $label"

    herdr --session "$session" \
        workspace focus "$workspace_id" >/dev/null || {
        die "unable to focus workspace '$label'"
        return 1
    }

    exec herdr --session "$session"
}

create_session() {
    local name="$1"
    local answer

    print
    print "Create session '$name'?"
    print "  y) Create"
    print "  n) Cancel"
    print -n "Choice [y/N]: "

    read -r answer

    case "$answer" in
        y|Y|yes|YES)
            print "Opening session: $name"
            exec herdr session attach "$name"
            ;;
        *)
            return 0
            ;;
    esac
}

select_session() {
    local label="$1"
    local sessions=()
    local session
    local selected
    local choice

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue
        sessions+=("$session")
    done < <(get_sessions)

    if (( ${#sessions[@]} == 0 )); then
        print
        print "No Herdr session exists yet."
        print
        print -n "Session name: "

        read -r selected

        [[ -n "$selected" ]] || return 1

        print
        print "Opening session: $selected"

        exec herdr session attach "$selected"
    fi

    print
    print "Select a session for workspace '$label':"
    print

    local i=1

    for session in "${sessions[@]}"; do
        print "  $i) $session"
        ((i++))
    done

    print
    print -n "Choice [1]: "

    read -r choice

    [[ -z "$choice" ]] && choice=1

    if ! [[ "$choice" =~ '^[0-9]+$' ]]; then
        die "invalid session selection"
        return 1
    fi

    if (( choice < 1 || choice > ${#sessions[@]} )); then
        die "invalid session selection"
        return 1
    fi

    REPLY="${sessions[$choice]}"
}

create_workspace() {
    local label="$1"
    local session="${2:-}"
    local cwd="$PWD"
    local answer

    if [[ -z "$session" ]]; then
        select_session "$label" || return 1
        session="$REPLY"
    fi

    print
    print "Create workspace:"
    print "  Session: $session"
    print "  Label:   $label"
    print "  CWD:     $cwd"
    print
    print -n "Create? [y/N]: "

    read -r answer

    case "$answer" in
        y|Y|yes|YES)
            herdr --session "$session" \
                workspace create \
                --cwd "$cwd" \
                --label "$label" \
                --focus >/dev/null || {
                die "unable to create workspace '$label'"
                return 1
            }

            print "Opening workspace: $label"
            exec herdr --session "$session"
            ;;
        *)
            return 0
            ;;
    esac
}

show_menu() {
    local sessions=()
    local session
    local workspace_id
    local label
    local index=1
    local choice
    local answer
    local target
    local type
    local target_session
    local target_workspace_id
    local target_label

    while IFS= read -r session; do
        [[ -n "$session" ]] || continue
        sessions+=("$session")
    done < <(get_sessions)

    print
    print "Work"
    print "────────────────────────────────────────"

    local -a targets=()

    for session in "${sessions[@]}"; do
        print "  $index) [session] $session"

        targets+=("session"$'\t'"$session")
        ((index++))

        while IFS=$'\t' read -r workspace_id label; do
            [[ -n "$label" ]] || continue

            print "  $index)   [workspace] $label"

            targets+=(
                "workspace"$'\t'"$session"$'\t'"$workspace_id"$'\t'"$label"
            )

            ((index++))
        done < <(get_workspaces "$session")
    done

    if (( ${#targets[@]} == 0 )); then
        print "  No work contexts found."
        print
        print -n "Create a session? [y/N]: "

        read -r answer

        case "$answer" in
            y|Y|yes|YES)
                print -n "Session name: "
                read -r session

                [[ -n "$session" ]] && create_session "$session"
                ;;
        esac

        return 0
    fi

    print
    print "  q) Quit"
    print
    print -n "Select: "

    read -r choice

    [[ "$choice" == "q" || "$choice" == "Q" ]] && return 0

    [[ "$choice" =~ '^[0-9]+$' ]] || return 0

    if (( choice < 1 || choice > ${#targets[@]} )); then
        return 0
    fi

    target="${targets[$choice]}"

    type="${target%%$'\t'*}"
    target="${target#*$'\t'}"

    if [[ "$type" == "session" ]]; then
        attach_session "$target"
        return
    fi

    target_session="${target%%$'\t'*}"
    target="${target#*$'\t'}"

    target_workspace_id="${target%%$'\t'*}"
    target_label="${target#*$'\t'}"

    focus_workspace \
        "$target_session" \
        "$target_workspace_id" \
        "$target_label"
}

open_target() {
    local target="$1"
    local workspace
    local session
    local workspace_id
    local label

    if session_exists "$target"; then
        attach_session "$target"
        return
    fi

    workspace="$(workspace_lookup "$target")" || workspace=""

    if [[ -n "$workspace" ]]; then
        session="${workspace%%$'\t'*}"
        workspace="${workspace#*$'\t'}"

        workspace_id="${workspace%%$'\t'*}"
        label="${workspace#*$'\t'}"

        focus_workspace "$session" "$workspace_id" "$label"
        return
    fi

    print
    print "No session or workspace named '$target'."

    local suggestions=()
    local suggestion

    while IFS= read -r suggestion; do
        [[ -n "$suggestion" ]] || continue
        suggestions+=("$suggestion")
    done < <(similar_names "$target")

    if (( ${#suggestions[@]} > 0 )); then
        print
        print "Did you mean?"

        local i=1

        for suggestion in "${suggestions[@]}"; do
            print "  $i) $suggestion"
            ((i++))
        done

        print
        print -n "Open one of these? [1-${#suggestions[@]}/n]: "

        local choice
        read -r choice

        if [[ "$choice" =~ '^[0-9]+$' ]] &&
            (( choice >= 1 && choice <= ${#suggestions[@]} )); then
            open_target "${suggestions[$choice]}"
            return
        fi
    fi

    print
    print "Create '$target' as:"
    print "  1) Session"
    print "  2) Workspace"
    print "  q) Cancel"
    print
    print -n "Choice [q]: "

    local choice
    read -r choice

    case "$choice" in
        1)
            create_session "$target"
            ;;
        2)
            create_workspace "$target"
            ;;
        *)
            return 0
            ;;
    esac
}

show_help() {
    cat <<'EOF'
Usage:
  work
  work <session_or_workspace>

Open a Herdr session or workspace.

Behavior:
  work                    Interactive work context selector
  work <name>             Open a session or workspace named <name>

Resolution:
  1. Exact session match
  2. Exact workspace match
  3. Close-name suggestions
  4. Create a session or workspace

Sessions take precedence over workspaces when both have
the same name.

Options:
  -h, --help              Show this help
  -v, --version           Show version
      --completion-zsh    Output completion candidates for Zsh
      --completion-bash   Output completion candidates for Bash
EOF
}

main() {
    case "${1:-}" in
        "")
            show_menu
            ;;

        --version|-v)
            print -- "work $WORK_VERSION"
            ;;

        --help|-h)
            show_help
            ;;

        --completion-zsh)
            get_completion_contexts
            ;;

        --completion-bash)
            get_completion_contexts
            ;;

        --*)
            die "unknown option: $1"
            return 1
            ;;

        *)
            if (( $# > 1 )); then
                die "expected zero or one argument"
                return 1
            fi

            open_target "$1"
            ;;
    esac
}

main "$@"
